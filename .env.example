# BitAXE Miner Configuration
# MINERS_CONFIG is a JSON dict mapping miner names to their IP addresses.
#
# Format:
#   {"miners": {"<name>": {"ip": "<address>"}, ...}}
#
# Example:
#   MINERS_CONFIG='{"miners":{"alpha-1":{"ip":"10.0.0.1"},"beta-1":{"ip":"10.0.0.2"}}}'
MINERS_CONFIG='{"miners":{"alpha-1":{"ip":"10.0.0.1"}}}'
